var BEHAVIOR_DESCRIPTIONS = {
  sticky: "Fixes position to viewport edge during scroll",
  floating: "Elevated floating element above document flow",
  overlay: "Backdrop modal or drawer overlaying screen",
  fixed: "Strict fixed viewport position",
  fullscreen: "Expands across the entire viewport",
  autoplay: "Automatically loops / plays media or slider",
  parallax: "Scroll-linked differential speed effect",
  expandable: "Collapsible accordion or dropdown section",
  draggable: "Supports pointer drag interactions",
  "scroll-snap": "Snaps child containers into view on scroll"
};
function collectCanvasFeatures(roots) {
  const widgetTypes = /* @__PURE__ */ new Set();
  const behaviors = /* @__PURE__ */ new Set();
  const styles = {
    hasWidth: false,
    hasAlign: false,
    hasDist: false,
    hasRel: false,
    hasNote: false
  };
  const visit = (node) => {
    if (node.widgetType) {
      widgetTypes.add(node.widgetType);
    }
    const nodeBehaviors = node.textProps?.behaviors || node.style?.behaviors;
    if (Array.isArray(nodeBehaviors)) {
      for (const b of nodeBehaviors) {
        behaviors.add(b);
      }
    }
    if (node.style) {
      if (node.style.widthToken || typeof node.style.widthPct === "number") {
        styles.hasWidth = true;
      }
      if (node.style.align || node.style.alignY) {
        styles.hasAlign = true;
      }
      if (node.style.dist) {
        styles.hasDist = true;
      }
      if (node.style.rel) {
        styles.hasRel = true;
      }
      if (node.style.note || typeof node.textProps?.note === "string" && node.textProps.note.trim() !== "") {
        styles.hasNote = true;
      }
    }
    for (const child of node.children) {
      visit(child);
    }
  };
  for (const root of roots) {
    visit(root);
  }
  return { widgetTypes, behaviors, styles };
}
function generateAnnotationLegend(roots, options) {
  const profile = getPlatformProfile(options?.platform);
  const units = [];
  const rolesUsed = /* @__PURE__ */ new Set();
  const visit = (node) => {
    if (node.isUnit && node.unitName) {
      units.push(node);
    } else if (node.role) {
      rolesUsed.add(node.role);
    }
    for (const c of node.children) {
      visit(c);
    }
  };
  for (const r of roots) {
    visit(r);
  }
  const lines = [];
  lines.push("### MarkDraw Canvas Legend\n");
  if (units.length > 0) {
    lines.push("#### Custom Units");
    lines.push("| Notation | Meaning | Composition |");
    lines.push("| :--- | :--- | :--- |");
    const seenUnitNames = /* @__PURE__ */ new Set();
    for (const u of units) {
      if (seenUnitNames.has(u.unitName)) continue;
      seenUnitNames.add(u.unitName);
      const composition = u.children.map((c) => c.role).join(" + ") || "\u2014";
      const meaning = capitalize(u.role);
      lines.push(`| [${u.unitName}] | ${meaning} | ${composition} |`);
    }
    lines.push("");
  }
  lines.push("#### Standard Roles");
  lines.push("| Notation | Meaning | Example |");
  lines.push("| :--- | :--- | :--- |");
  const sortedRoles = Array.from(rolesUsed).sort();
  for (const role of sortedRoles) {
    const entry = ROLE_LEGEND_MAP[role] || {
      notation: `[${role}]`,
      meaning: `${capitalize(role)} component`,
      example: `[${role}]`
    };
    let notation = entry.notation;
    if (profile.roleAliases && profile.roleAliases[role]) {
      const alias = profile.roleAliases[role];
      notation = notation.replace(`[${role}`, `[${alias}`);
    }
    lines.push(`| ${notation} | ${entry.meaning} | ${entry.example} |`);
  }
  return lines.join("\n");
}
function generateCanvasLegend(roots, options) {
  if (!roots || roots.length === 0) {
    return "";
  }
  if (roots.some((r) => r.isAnnotationNode)) {
    return generateAnnotationLegend(roots, options);
  }
  const { widgetTypes, behaviors, styles } = collectCanvasFeatures(roots);
  const lines = [];
  lines.push("### MarkDraw Canvas Legend");
  lines.push("_Auto-generated contract legend for widgets and styles present on this canvas._\n");
  lines.push("| Notation | Meaning | Example |");
  lines.push("| :--- | :--- | :--- |");
  lines.push("| `[Text Placeholder]` | placeholder content should be filled with dummy data | \u2014 |");
  const sortedTypes = Array.from(widgetTypes).sort();
  for (const type of sortedTypes) {
    const entry = WIDGET_LEGEND_MAP[type] || {
      notation: `[${type}]`,
      meaning: `${type} widget`,
      example: `[${type}]`
    };
    lines.push(`| \`${entry.notation}\` | ${entry.meaning} | \`${entry.example}\` |`);
  }
  const styleRows = [];
  if (styles.hasWidth) {
    styleRows.push("| `width:50%` / `full-width` / `overflow` | measured span relative to parent | `width:50%` |");
  }
  if (styles.hasAlign) {
    styleRows.push("| `align:left\\|center\\|right`, `align-y` | position within parent (default: stretch/left) | `align:center` |");
  }
  if (styles.hasDist) {
    styleRows.push("| `dist:grid\\|wrap` | distribution arrangement along layout flow | `dist:grid cols:2 rows:2` |");
  }
  if (styles.hasRel) {
    styleRows.push("| `rel:overflow\\|overlap\\|inset` | spatial relationship to parent or sibling boundary | `rel:overflow` |");
  }
  if (styles.hasNote) {
    styleRows.push('| `note:"..."` | free-text styling or state hint (non-binding) | `note:"sticky header"` |');
  }
  const sortedBehaviors = Array.from(behaviors).sort();
  for (const b of sortedBehaviors) {
    const desc = BEHAVIOR_DESCRIPTIONS[b] || "user-declared behavior flag; implement literally";
    styleRows.push(`| \`${b}\` | ${desc} | \`[card ${b}]\` |`);
  }
  if (styleRows.length > 0) {
    lines.push("");
    lines.push("**Active Style & Behavior Semantics**");
    lines.push("| Axis / Flag | Meaning | Example |");
    lines.push("| :--- | :--- | :--- |");
    lines.push(...styleRows);
  }
  return lines.join("\n");
}

// src/core/ascii.ts
var AsciiSerializer = class {
  static serialize(roots, rootWidth = 78) {
    if (!roots || roots.length === 0) {
      return "_Canvas is empty. Draw shapes or add UI components to generate the ASCII layout._";
    }
    const output = [];
    output.push("```text");
    for (const rawRoot of roots) {
      const root = this.toIRNode(rawRoot);
      const boxLines = this.renderNode(root, rootWidth);
      output.push(boxLines.join("\n"));
      output.push("");
    }
    output.push("```");
    return output.join("\n");
  }
  static toIRNode(node) {
    if ("bounds" in node && "textProps" in node) {
      return node;
    }
    const ln = node;
    return {
      id: ln.id,
      shortId: ln.id.slice(-4),
      widgetType: ln.widgetType || (ln.role === "container" ? "section" : ln.role === "button" ? "button" : "heading"),
      role: ln.role,
      label: ln.label,
      textProps: ln.widgetProps || { label: ln.shape?.text || ln.label },
      bounds: ln.shape?.bounds || { x: 0, y: 0, w: 100, h: 40 },
      children: (ln.children || []).map((c) => this.toIRNode(c)),
      parent: ln.parent,
      direction: ln.direction,
      path: ln.path
    };
  }
  static renderNode(node, targetWidth) {
    const width = Math.max(20, Math.min(120, targetWidth));
    const notation = formatSemanticNotation(node);
    const flowTag = node.direction !== "Leaf" ? ` (${node.direction})` : "";
    const title = ` ${notation}${flowTag} `;
    const remainingDashes = Math.max(0, width - 3 - title.length);
    const topLine = `\u250C\u2500${title}${"\u2500".repeat(remainingDashes)}\u2510`;
    const botLine = `\u2514${"\u2500".repeat(Math.max(0, width - 2))}\u2518`;
    if (node.children.length === 0) {
      const p = node.textProps || {};
      let detail = p.label || p.placeholder || node.label;
      if (node.widgetType === "paragraph") {
        detail = "\u2500\u2500\u2500 \u2500\u2500\u2500 \u2500\u2500\u2500";
      }
      const innerText = `  ${detail}  `;
      const clampedText = innerText.slice(0, width - 4);
      const padRight = Math.max(0, width - 2 - clampedText.length);
      const midLine = `\u2502${clampedText}${" ".repeat(padRight)}\u2502`;
      return [topLine, midLine, botLine];
    }
    const innerWidth = width - 6;
    const bodyLines = [];
    if (node.direction === "Row") {
      const count = node.children.length;
      const gap = 2;
      const childWidth = Math.max(14, Math.floor((innerWidth - (count - 1) * gap) / count));
      const childrenBlocks = node.children.map((child) => this.renderNode(child, childWidth));
      const maxRows = Math.max(...childrenBlocks.map((b) => b.length));
      const normalizedBlocks = childrenBlocks.map((b) => {
        const padded = [...b];
        while (padded.length < maxRows) {
          padded.push(" ".repeat(childWidth));
        }
        return padded;
      });
      for (let r = 0; r < maxRows; r++) {
        const rowStr = normalizedBlocks.map((b) => b[r]).join("  ");
        const padRight = Math.max(0, width - 2 - 2 - rowStr.length);
        bodyLines.push(`\u2502  ${rowStr}${" ".repeat(padRight)}\u2502`);
      }
    } else {
      for (let i = 0; i < node.children.length; i++) {
        const child = node.children[i];
        const childLines = this.renderNode(child, innerWidth);
        for (const line of childLines) {
          const padRight = Math.max(0, width - 2 - 2 - line.length);
          bodyLines.push(`\u2502  ${line}${" ".repeat(padRight)}\u2502`);
        }
        if (i < node.children.length - 1) {
          bodyLines.push(`\u2502${" ".repeat(width - 2)}\u2502`);
        }
      }
    }
    return [topLine, `\u2502${" ".repeat(width - 2)}\u2502`, ...bodyLines, `\u2502${" ".repeat(width - 2)}\u2502`, botLine];
  }
};

// src/core/compiler.ts
function capitalize2(str) {
  if (!str) return "";
  return str.charAt(0).toUpperCase() + str.slice(1);
}
function inferPlacement(node, parent) {
  if (!parent) {
    if (node.widgetType === "page" || node.role === "page") {
      return "\u2014";
    }
    if (node.widgetType === "navbar" || node.widgetType === "header" || node.role === "navbar") {
      return "header";
    }
    if (node.widgetType === "footer" || node.role === "footer") {
      return "footer";
    }
    return "body";
  }
  if (node.widgetType === "navbar" || node.widgetType === "header" || node.role === "navbar") {
    return "header";
  }
  if (node.widgetType === "footer" || node.role === "footer") {
    return "footer";
  }
  if (parent.widgetType === "page" || parent.role === "page") {
    if (node.isUnit) {
      return "nested";
    }
    const pageBounds = parent.bounds;
    const pageH = pageBounds.h;
    const pageW = pageBounds.w;
    const relTop = node.bounds.y - pageBounds.y;
    const widthRatio = pageW > 0 ? node.bounds.w / pageW : 0;
    const isWideEnough = widthRatio >= 0.7;
    if (relTop <= 0.15 * pageH && isWideEnough) {
      return "header";
    }
    const isBottom35 = node.bounds.y >= pageBounds.y + 0.65 * pageH;
    if (isBottom35 && isWideEnough) {
      const hasSiblingBelow = parent.children.some(
        (sib) => sib.id !== node.id && sib.bounds.y > node.bounds.y + 20
      );
      if (!hasSiblingBelow) {
        return "footer";
      }
    }
    return "body";
  }
  return "nested";
}
var MarkDrawCompiler = class {
  static compile(shapes, editor, options) {
    const opts = {
      containmentThreshold: options?.containmentThreshold ?? 0.85,
      rowClusterThreshold: options?.rowClusterThreshold ?? 16,
      gridBandThreshold: options?.gridBandThreshold ?? 32,
      sizeBucketTolerance: options?.sizeBucketTolerance ?? 2,
      alignTolerance: options?.alignTolerance ?? 3,
      includeTimestamp: options?.includeTimestamp ?? false,
      includeLegend: options?.includeLegend ?? false,
      pageNote: options?.pageNote ?? "",
      platform: options?.platform ?? (options?.platformId === "android-material" ? "android-material" : "web"),
      platformId: options?.platformId ?? options?.platform ?? "web",
      scope: options?.scope ?? null,
      units: options?.units ?? [],
      annotationMode: options?.annotationMode ?? false
    };
    const ir = buildIRTree(shapes, editor, opts.containmentThreshold, options);
    let specBody = this.serializeSpecTable(ir.roots, opts);
    if (ir.relations && ir.relations.length > 0) {
      specBody += `

${ir.relations.join("\n")}`;
    }
    const gridBody = this.serializeSpatialGrid(ir.roots, opts.gridBandThreshold);
    const asciiBody = AsciiSerializer.serialize(ir.roots);
    const jsonAst = serializeIRToJsonAst(ir.roots);
    let directivePrefix = `${AI_DIRECTIVE_HEADER}

`;
    if (ir.scopedMeta) {
      const uCount = ir.scopedMeta.unitCount;
      const nCount = ir.scopedMeta.nodeCount;
      const uStr = `${uCount} unit${uCount === 1 ? "" : "s"}`;
      const nStr = `${nCount} node${nCount === 1 ? "" : "s"}`;
      directivePrefix = `_Scoped compile: "${ir.scopedMeta.scopeName}" \u2014 ${uStr}, ${nStr} (of ${ir.scopedMeta.totalNodes} in "${ir.scopedMeta.rootName}")_

`;
    } else if (ir.roots.some((r) => r.isAnnotationNode)) {
      const profile = getPlatformProfile(opts.platform);
      const platLine = `Target platform: ${profile.displayName}. ${profile.directiveLines.join(" ")}`;
      const hasRespPage = ir.roots.some(
        (r) => r.role === "page" && (r.textProps?.isResponsive || r.textProps?.behaviors?.includes("responsive"))
      );
      const respLine = hasRespPage ? "\n> Responsive: this page must adapt to mobile widths; per-shape sm:* tokens are binding." : "";
      directivePrefix = `${AI_DIRECTIVE_HEADER}
> ${platLine}${respLine}

`;
    }
    const legendPrefix = opts.includeLegend ? `${generateCanvasLegend(ir.roots, opts)}

---

` : "";
    const warningSuffix = ir.skippedShapes && ir.skippedShapes > 0 ? `

_Warning: ${ir.skippedShapes} shape(s) skipped due to processing errors._` : "";
    return {
      markdownSpec: `${directivePrefix}${legendPrefix}${specBody}${warningSuffix}`,
      markdownGrid: `${legendPrefix}${gridBody}`,
      markdownAscii: `${legendPrefix}${asciiBody}`,
      jsonAst,
      timestamp: opts.includeTimestamp ? (/* @__PURE__ */ new Date()).toISOString() : "",
      elementCount: ir.elementCount,
      lints: ir.lints || []
    };
  }
  static normalize(shapes, editor) {
    const results = [];
    for (const s of shapes) {
      const props = s.props || {};
      const rawText = props.text || props.name || props.label || "";
      const text = sanitizeMarkdown(rawText);
      let x = s.x;
      let y = s.y;
      let w = typeof props.w === "number" ? props.w : 100;
      let h = typeof props.h === "number" ? props.h : 100;
      if (editor && typeof editor.getShapePageBounds === "function") {
        const pageBounds = editor.getShapePageBounds(s);
        if (pageBounds) {
          x = pageBounds.x;
          y = pageBounds.y;
          w = pageBounds.w;
          h = pageBounds.h;
        }
      }
      if (w < 4 || h < 4) continue;
      const bounds = { x, y, w, h };
      const aabb = computeAABB(bounds);
      const widgetType = props.widgetType || void 0;
      const meta = getShapeMeta(s);
      const role = meta?.role || (widgetType ? V3_WIDGET_TO_V4_ROLE_MAP[widgetType]?.targetRole || widgetType : "unknown");
      results.push({
        id: s.id,
        type: s.type,
        bounds,
        aabb,
        color: props.color || "black",
        isDashed: props.dash === "dashed",
        text,
        role,
        widgetType,
        widgetProps: props
      });
    }
    return results;
  }
  static formatProps(node, parent) {
    const p = node.textProps || node.widgetProps;
    const style = node.style;
    if (!p && !style) return "\u2014";
    const type = node.widgetType || node.role || "";
    const defaults = getRoleDefaultProps(type);
    const propsPairs = [];
    if (node.isUnit && node.unitName) {
      propsPairs.push(`unit:"${node.unitName}"`);
    }
    const isPage = node.role === "page" || node.widgetType === "page";
    if (isPage && (p?.isResponsive || style?.isResponsive)) {
      propsPairs.push("responsive");
    }
    if (p) {
      if (p.variant && p.variant !== defaults.variant && p.variant !== "default" && p.variant !== "solid" && type !== "grid_gallery" && type !== "data_table" && type !== "table") {
        propsPairs.push(`variant="${p.variant}"`);
      }
      if (p.placeholder && p.placeholder !== defaults.placeholder) {
        propsPairs.push(`placeholder="${p.placeholder}"`);
      }
      if (typeof p.checked === "boolean" && p.checked === true && p.checked !== defaults.checked) {
        propsPairs.push(`checked=${p.checked}`);
      }
      if (p.options && p.options !== defaults.options && type !== "tabs") {
        propsPairs.push(`options=[${p.options}]`);
      }
      if (typeof p.value === "number" && p.value > 0 && p.value !== defaults.value && type !== "list" && type !== "avatar_group" && type !== "steps" && type !== "pagination") {
        propsPairs.push(`value=${p.value}`);
      }
      if (p.iconName && p.iconName !== defaults.iconName) {
        propsPairs.push(`icon="${p.iconName}"`);
      }
      if (p.subtext && p.subtext !== defaults.subtext) {
        propsPairs.push(`subtext="${p.subtext}"`);
      }
      if (p.altText && p.altText !== defaults.altText) {
        propsPairs.push(`alt="${p.altText}"`);
      }
      if (typeof p.showText === "boolean" && p.showText === true && p.showText !== defaults.showText) {
        propsPairs.push(`showText=${p.showText}`);
      }
    }
    if (type === "avatar_group") {
      const count = typeof p?.value === "number" && p.value > 0 ? p.value : 3;
      propsPairs.push(`count:${count}`);
    } else if (type === "list") {
      const count = typeof p?.value === "number" && p.value > 0 ? p.value : 5;
      propsPairs.push(`count:${count}`);
    } else if (type === "steps") {
      let count = 4;
      if (typeof p?.value === "number" && p.value > 0) {
        count = p.value;
      } else if (p?.variant) {
        const m = p.variant.match(/\d+-(\d+)/);
        if (m) count = parseInt(m[1], 10);
      }
      propsPairs.push(`count:${count}`);
    } else if (type === "pagination") {
      let count = 5;
      if (typeof p?.value === "number" && p.value > 0) {
        count = p.value;
      } else if (p?.variant) {
        const m = p.variant.match(/\d+\/(\d+)/);
        if (m) count = parseInt(m[1], 10);
      }
      propsPairs.push(`count:${count}`);
    } else if (type === "tabs") {
      let count = 3;
      if (typeof p?.value === "number" && p.value > 0) {
        count = p.value;
      } else if (p?.options) {
        const opts = p.options.split(/[|,]/).filter(Boolean);
        if (opts.length > 0) count = opts.length;
      }
      propsPairs.push(`count:${count}`);
    }
    if (typeof node.patternCount === "number" && node.patternCount >= 2) {
      propsPairs.push(`count:${node.patternCount}`);
    }
    if (type === "grid_gallery" || type === "data_table" || type === "table" || node.role === "table" || p?.variant && /^\d+x\d+$/.test(p.variant)) {
      const v = p?.variant || (type === "grid_gallery" ? "3x2" : "4x3");
      const m = v.match(/^(\d+)x(\d+)$/);
      if (m) {
        propsPairs.push(`${m[1]} cols \xD7 ${m[2]} rows`);
      }
    }
    const columns = p?.columns ?? style?.columns;
    if (typeof columns === "number" && columns > 1) {
      const split = p?.columnSplit ?? style?.columnSplit;
      propsPairs.push(`cols:${columns}${split && split !== "equal" ? ` (${split})` : ""}`);
    }
    const isResponsive = !isPage && (p?.isResponsive ?? style?.isResponsive);
    if (isResponsive) {
      const mobileStack = p?.mobileStack ?? style?.mobileStack ?? "stack";
      propsPairs.push(`responsive:${mobileStack}`);
      const tabletLayout = p?.tabletLayout ?? style?.tabletLayout;
      if (tabletLayout && tabletLayout !== "maintain") {
        propsPairs.push(`tablet:${tabletLayout}`);
      }
    }
    const styleTokens = [];
    if (style) {
      if (style.widthToken) {
        const parentProps = parent ? parent.textProps || parent.widgetProps : null;
        const parentResponsive = parentProps?.isResponsive ?? parent?.style?.isResponsive;
        if (parentResponsive && style.widthToken !== "full-width" && !style.widthToken.includes("sm:")) {
          styleTokens.push(`${style.widthToken} (sm:full)`);
        } else {
          styleTokens.push(style.widthToken);
        }
      }
      if (style.heightToken) {
        styleTokens.push(`height:${style.heightToken}`);
      }
      if (style.align) {
        styleTokens.push(`align:${style.align}`);
      }
      if (style.alignY) {
        styleTokens.push(`align-y:${style.alignY}`);
      }
      if (style.dist) {
        styleTokens.push(style.dist);
      }
      if (style.rel) {
        styleTokens.push(`rel:${style.rel}`);
      }
      if (Array.isArray(style.behaviors) && style.behaviors.length > 0) {
        for (const b of style.behaviors) {
          if (b === "responsive" && isPage) continue;
          if (!propsPairs.includes(b) && !styleTokens.includes(b)) {
            styleTokens.push(b);
          }
        }
      }
      if (style.note) {
        styleTokens.push(`note:"${style.note}"`);
      }
    } else if (p) {
      if (Array.isArray(p.behaviors) && p.behaviors.length > 0) {
        for (const b of p.behaviors) {
          if (b === "responsive" && isPage) continue;
          if (!propsPairs.includes(b) && !styleTokens.includes(b)) {
            styleTokens.push(b);
          }
        }
      }
      if (typeof p.note === "string" && p.note.trim() !== "") {
        styleTokens.push(`note:"${p.note.trim()}"`);
      }
    }
    const mobileOrder = typeof p?.mobileOrder === "number" ? p.mobileOrder : style?.mobileOrder;
    if (typeof mobileOrder === "number") {
      styleTokens.push(`sm:order-${mobileOrder}`);
    }
    const hideOnMobile = p?.hideOnMobile ?? style?.hideOnMobile;
    if (hideOnMobile) {
      styleTokens.push("sm:hidden");
    }
    const inUnit = Boolean(
      node.isUnit || node.unitId || parent?.isUnit || parent?.unitId
    );
    if (inUnit) {
      return propsPairs.join(", ");
    }
    const propsStr = propsPairs.join(", ");
    const styleStr = styleTokens.join(" ");
    if (propsStr && styleStr) {
      return `${propsStr} ${styleStr}`;
    }
    if (propsStr) return propsStr;
    if (styleStr) return styleStr;
    return "\u2014";
  }
  static toIRNode(node) {
    if ("bounds" in node && "textProps" in node) {
      return node;
    }
    const ln = node;
    return {
      id: ln.id,
      shortId: ln.id.slice(-4),
      widgetType: ln.widgetType || (ln.role === "container" ? "section" : ln.role === "button" ? "button" : "heading"),
      role: ln.role,
      label: ln.label,
      textProps: ln.widgetProps || {
        label: ln.shape?.text || ln.label
      },
      bounds: ln.shape?.bounds || { x: 0, y: 0, w: 100, h: 40 },
      children: (ln.children || []).map((c) => this.toIRNode(c)),
      parent: ln.parent,
      direction: ln.direction,
      path: ln.path,
      style: ln.style
    };
  }
  static serializeSpecTable(roots, options) {
    if (!roots || roots.length === 0) {
      return "_Canvas is empty. Draw shapes or drop UI components to generate the specification._";
    }
    const irRoots = roots.map((r) => this.toIRNode(r));
    const rows = [];
    rows.push("### MarkDraw UI Specification");
    if (options?.includeTimestamp) {
      rows.push(`**Generated:** ${(/* @__PURE__ */ new Date()).toISOString()}  `);
    }
    const rootPage = irRoots.find((r) => r.role === "page" || r.widgetType === "page");
    const effectivePageNote = options?.pageNote || rootPage?.textProps?.note || rootPage?.style?.note;
    if (effectivePageNote) {
      rows.push(`**Page note:** ${effectivePageNote}  `);
    }
    rows.push(`**Roots Detected:** ${irRoots.length} view(s)
`);
    rows.push("#### Semantic Hierarchy Table");
    rows.push(
      "| Path | Component | Semantics | Placement | Layout Flow | Props & Attributes | Children / Content |"
    );
    rows.push(
      "| :--- | :--- | :--- | :--- | :--- | :--- | :--- |"
    );
    const walk = (node, parent) => {
      const notation = formatSemanticNotation(node);
      let childBadges = "\u2014";
      if (node.isUnit && node.children.length > 0) {
        childBadges = node.children.map((c) => {
          const raw = c.textProps?.label || c.label;
          const hasLit = !isUntouchedRoleLabel(c.role, raw);
          if (c.role === "button" && hasLit) {
            return `"${raw}"`;
          }
          return c.role;
        }).join(", ");
      } else if (node.children.length === 1 && node.children[0].isUnit) {
        childBadges = `1 \xD7 [${node.children[0].unitName || node.children[0].label}]`;
      } else if (node.children.length > 0) {
        childBadges = detectSiblingPatterns(node.children);
      } else {
        const rawLabel = node.textProps?.label || node.label;
        const isUntouched = isUntouchedRoleLabel(node.role, rawLabel);
        if (isUntouched) {
          childBadges = '"content: [Text Placeholder]"';
        } else if (rawLabel) {
          childBadges = `"${rawLabel}"`;
        } else {
          childBadges = "\u2014";
        }
      }
      const semanticsBadge = `<${capitalize2(node.role)}>`;
      const placement = inferPlacement(node, parent);
      const layoutFlow = node.children.length > 0 ? node.direction === "Leaf" ? "Column" : node.direction : "\u2014";
      const propsStr = this.formatProps(node, parent);
      const propsCol = propsStr ? ` ${propsStr} ` : " ";
      rows.push(
        `| \`${node.path}\` | **${notation}** | ${semanticsBadge} | ${placement} | ${layoutFlow} |${propsCol}| ${childBadges} |`
      );
      for (const child of node.children) {
        walk(child, node);
      }
    };
    for (const root of irRoots) {
      walk(root, null);
    }
    return rows.join("\n");
  }
  static serializeSpatialGrid(roots, gridBandThreshold = 32) {
    if (!roots || roots.length === 0) return "_Canvas is empty._";
    const irRoots = roots.map((r) => this.toIRNode(r));
    const lines = [];
    lines.push("### Spatial Grid Layout Table\n");
    const rowClustered = [];
    const sortedRoots = [...irRoots].sort((a, b) => a.bounds.y - b.bounds.y);
    for (const node of sortedRoots) {
      let placed = false;
      for (const cluster of rowClustered) {
        const clusterY = cluster[0].bounds.y;
        if (Math.abs(node.bounds.y - clusterY) <= gridBandThreshold) {
          cluster.push(node);
          placed = true;
          break;
        }
      }
      if (!placed) {
        rowClustered.push([node]);
      }
    }
    let maxCols = 0;
    for (const cluster of rowClustered) {
      cluster.sort((a, b) => a.bounds.x - b.bounds.x);
      maxCols = Math.max(maxCols, cluster.length);
    }
    if (maxCols === 0) return "_No spatial cells formed._";
    const headers = Array.from({ length: maxCols }, (_, i) => `Col ${i + 1}`);
    lines.push(`| ${headers.join(" | ")} |`);
    lines.push(`| ${headers.map(() => ":---").join(" | ")} |`);
    for (const cluster of rowClustered) {
      const cellValues = cluster.map((n) => formatSemanticNotation(n));
      while (cellValues.length < maxCols) {
        cellValues.push("\u2014");
      }
      lines.push(`| ${cellValues.join(" | ")} |`);
    }
    return lines.join("\n");
  }
};

// src/cli/compile.ts
function canvasShapesToCompilerShapes(canvasShapes) {
  return canvasShapes.map((s) => ({
    id: s.id,
    type: s.kind === "frame" ? "frame" : s.kind === "group" ? "group" : "geo",
    x: s.bounds.x,
    y: s.bounds.y,
    rotation: s.bounds.rotation || 0,
    parentId: s.parentId,
    props: {
      geo: s.kind === "ellipse" ? "ellipse" : s.kind === "diamond" ? "diamond" : "rectangle",
      w: s.bounds.w,
      h: s.bounds.h,
      text: s.text,
      name: s.name
    },
    meta: s.meta
  }));
}
function compileStoredDocument(doc, options = {}) {
  const compilerShapes = canvasShapesToCompilerShapes(doc.shapes);
  let scopeConfig = null;
  if (options.root) {
    const targetRoot = doc.shapes.find(
      (s) => s.id === options.root || s.name === options.root || s.text === options.root || s.meta?.markdraw?.props?.label === options.root
    );
    if (!targetRoot) {
      throw new Error(`Root shape not found matching "${options.root}"`);
    }
    const label = targetRoot.name || targetRoot.meta?.markdraw?.props?.label || targetRoot.id;
    scopeConfig = {
      shapeIds: [targetRoot.id],
      scopeName: label
    };
  } else if (options.scope && options.scope !== "all") {
    scopeConfig = {
      shapeIds: [options.scope]
    };
  }
  const compileOpts = {
    units: doc.units || [],
    platformId: options.platform || "web",
    scope: scopeConfig
  };
  const result = MarkDrawCompiler.compile(compilerShapes, null, compileOpts);
  return options.json ? result.jsonAst : result.markdownSpec;
}
function parseArgs(argv) {
  const args = argv.slice(2);
  let command;
  let filePath;
  const options = {};
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (arg === "compile") {
      command = "compile";
    } else if (arg === "--root" && i + 1 < args.length) {
      options.root = args[++i];
    } else if (arg === "--platform" && i + 1 < args.length) {
      options.platform = args[++i];
    } else if (arg === "--scope" && i + 1 < args.length) {
      options.scope = args[++i];
    } else if (arg === "--json") {
      options.json = true;
    } else if (arg === "--help" || arg === "-h") {
      command = "help";
    } else if (arg === "--version" || arg === "-v") {
      command = "version";
    } else if (!arg.startsWith("-") && !filePath) {
      filePath = arg;
    }
  }
  return { command: command || (filePath ? "compile" : "help"), filePath, options };
}
function runCli(argv = process.argv) {
  const { command, filePath, options } = parseArgs(argv);
  if (command === "help") {
    console.log(`
MarkDraw v5 CLI \u2014 Headless Compiler

Usage:
  markdraw compile <file.md.json> [options]

Options:
  --root <id|name>               Root frame or container to compile
  --platform <web|android-material>  Target platform profile (default: web)
  --scope <all|id>               Scope compilation to all or specific shape
  --json                         Emit JSON AST instead of Markdown contract
  --help, -h                     Show this help message
  --version, -v                  Show version
`);
    process.exit(0);
  }
  if (command === "version") {
    console.log("markdraw v5.0.0");
    process.exit(0);
  }
  if (command === "compile") {
    if (!filePath) {
      console.error("Error: Please specify an input document file path.");
      process.exit(1);
    }
    const resolvedPath = path.resolve(process.cwd(), filePath);
    if (!fs.existsSync(resolvedPath)) {
      console.error(`Error: File not found: ${resolvedPath}`);
      process.exit(1);
    }
    try {
      const raw = fs.readFileSync(resolvedPath, "utf-8");
      const doc = JSON.parse(raw);
      const output = compileStoredDocument(doc, options);
      process.stdout.write(output + (output.endsWith("\n") ? "" : "\n"));
      process.exit(0);
    } catch (err) {
      console.error(`Compilation Error: ${err.message || err}`);
      process.exit(1);
    }
  }
}
if (process.argv[1] && (process.argv[1].endsWith("compile.ts") || process.argv[1].endsWith("markdraw"))) {
  runCli();
}
export {
  canvasShapesToCompilerShapes,
  compileStoredDocument,
  parseArgs,
  runCli
};
