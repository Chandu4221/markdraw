// src/core/geometry.ts
function computeAABB(bounds) {
  return {
    x1: bounds.x,
    y1: bounds.y,
    x2: bounds.x + bounds.w,
    y2: bounds.y + bounds.h
  };
}
function calculateIntersectionArea(a, b) {
  const xOverlap = Math.max(0, Math.min(a.x2, b.x2) - Math.max(a.x1, b.x1));
  const yOverlap = Math.max(0, Math.min(a.y2, b.y2) - Math.max(a.y1, b.y1));
  return xOverlap * yOverlap;
}
function getEnclosureRatio(child, parent) {
  const childArea = (child.x2 - child.x1) * (child.y2 - child.y1);
  if (childArea <= 0) return 0;
  const intersection = calculateIntersectionArea(child, parent);
  return intersection / childArea;
}
function sanitizeMarkdown(text) {
  if (!text) return "";
  return text.replace(/\|/g, "\\|").replace(/\r?\n/g, "<br/>").trim();
}

// src/core/style.ts
function getWidthPct(node, parent) {
  if (!parent || parent.bounds.w <= 0) return 100;
  return Math.round(node.bounds.w / parent.bounds.w * 100);
}
function getWidthBucket(node, parent, tolerance = 2) {
  const widthPct = getWidthPct(node, parent);
  if (widthPct > 100) {
    return `overflow:${widthPct}%`;
  }
  if (widthPct >= 95 - tolerance && widthPct <= 100) {
    return "full-width";
  }
  if (Math.abs(widthPct - 75) <= tolerance) {
    return "75%";
  }
  if (widthPct >= 66 - tolerance && widthPct <= 67 + tolerance || Math.abs(widthPct - 66.67) <= tolerance) {
    return "2/3";
  }
  if (Math.abs(widthPct - 50) <= tolerance) {
    return "50%";
  }
  if (widthPct >= 33 - tolerance && widthPct <= 34 + tolerance || Math.abs(widthPct - 33.33) <= tolerance) {
    return "1/3";
  }
  if (Math.abs(widthPct - 25) <= tolerance) {
    return "25%";
  }
  return `${widthPct}%`;
}
function inferDistribution(children) {
  if (!children || children.length < 2) return void 0;
  const rows = [];
  const sortedByY = [...children].sort((a, b) => a.bounds.y - b.bounds.y);
  for (const child of sortedByY) {
    let placed = false;
    for (const row of rows) {
      if (Math.abs(child.bounds.y - row[0].bounds.y) <= 16) {
        row.push(child);
        placed = true;
        break;
      }
    }
    if (!placed) {
      rows.push([child]);
    }
  }
  if (rows.length >= 2) {
    const colCount = rows[0].length;
    const isUniformCols = colCount >= 2 && rows.every((r) => r.length === colCount);
    if (isUniformCols) {
      for (const row of rows) {
        row.sort((a, b) => a.bounds.x - b.bounds.x);
      }
      let colsAligned = true;
      for (let c = 0; c < colCount; c++) {
        const colX0 = rows[0][c].bounds.x;
        for (let r = 1; r < rows.length; r++) {
          if (Math.abs(rows[r][c].bounds.x - colX0) > 24) {
            colsAligned = false;
            break;
          }
        }
        if (!colsAligned) break;
      }
      if (colsAligned) {
        return `dist:grid cols:${colCount} rows:${rows.length}`;
      }
    }
    return "dist:wrap";
  }
  return void 0;
}
function inferNodeStyle(node, parent, siblings = [], options) {
  const style = {};
  const sizeTol = options?.sizeBucketTolerance ?? 2;
  const alignTol = options?.alignTolerance ?? 3;
  const rawBehaviors = node.textProps?.behaviors;
  if (Array.isArray(rawBehaviors) && rawBehaviors.length > 0) {
    style.behaviors = [...rawBehaviors];
  }
  const rawNote = node.textProps?.note;
  if (typeof rawNote === "string" && rawNote.trim() !== "") {
    style.note = rawNote.trim();
  }
  if (typeof node.textProps?.columns === "number" && node.textProps.columns > 1) {
    style.columns = node.textProps.columns;
    if (node.textProps.columnSplit) {
      style.columnSplit = node.textProps.columnSplit;
    }
  }
  if (node.textProps?.isResponsive) {
    style.isResponsive = true;
    style.mobileStack = node.textProps.mobileStack || "stack";
    if (node.textProps.tabletLayout) {
      style.tabletLayout = node.textProps.tabletLayout;
    }
  }
  if (typeof node.textProps?.mobileOrder === "number") {
    style.mobileOrder = node.textProps.mobileOrder;
  }
  if (node.textProps?.hideOnMobile) {
    style.hideOnMobile = true;
  }
  if (node.children && node.children.length >= 2) {
    const dist = inferDistribution(node.children);
    if (dist) {
      style.dist = dist;
    }
  }
  if (!parent || parent.bounds.w <= 0 || parent.bounds.h <= 0) {
    return style;
  }
  const widthPct = getWidthPct(node, parent);
  style.widthPct = widthPct;
  const bucket = getWidthBucket(node, parent, sizeTol);
  let omitWidth = false;
  if (siblings.length >= 2) {
    const allSameBucket = siblings.every(
      (sib) => getWidthBucket(sib, parent, sizeTol) === bucket
    );
    if (allSameBucket) {
      omitWidth = true;
    }
  }
  if (!omitWidth) {
    if (bucket === "full-width") {
      style.widthToken = "full-width";
    } else if (bucket.startsWith("overflow:")) {
      style.widthToken = bucket;
    } else {
      style.widthToken = `width:${bucket}`;
    }
  }
  const heightPct = Math.round(node.bounds.h / parent.bounds.h * 100);
  if (heightPct < 10) {
    style.heightToken = "short";
  } else if (heightPct < 35) {
    style.heightToken = "compact";
  }
  const parentCenterX = parent.bounds.x + parent.bounds.w / 2;
  const childCenterX = node.bounds.x + node.bounds.w / 2;
  const offsetPct = Math.abs(childCenterX - parentCenterX) / parent.bounds.w * 100;
  const widthRatio = node.bounds.w / parent.bounds.w;
  if (widthRatio >= 0.95) {
  } else if (offsetPct <= alignTol) {
    style.align = "center";
  } else if (node.bounds.x >= parent.bounds.x + parent.bounds.w * (2 / 3) - 2 || childCenterX >= parent.bounds.x + parent.bounds.w * (2 / 3)) {
    style.align = "right";
  }
  if (node.bounds.h < 0.6 * parent.bounds.h) {
    const relTop = node.bounds.y - parent.bounds.y;
    const relBottom = parent.bounds.y + parent.bounds.h - (node.bounds.y + node.bounds.h);
    const parentCenterY = parent.bounds.y + parent.bounds.h / 2;
    const childCenterY = node.bounds.y + node.bounds.h / 2;
    const offsetYPct = Math.abs(childCenterY - parentCenterY) / parent.bounds.h * 100;
    if (relTop <= 0.15 * parent.bounds.h) {
      style.alignY = "top";
    } else if (offsetYPct <= alignTol + 2) {
      style.alignY = "middle";
    } else if (relBottom <= 0.15 * parent.bounds.h) {
      style.alignY = "bottom";
    }
  }
  const overflowLeft = node.bounds.x < parent.bounds.x - 0.05 * parent.bounds.w;
  const overflowRight = node.bounds.x + node.bounds.w > parent.bounds.x + parent.bounds.w + 0.05 * parent.bounds.w;
  const overflowTop = node.bounds.y < parent.bounds.y - 0.05 * parent.bounds.h;
  const overflowBottom = node.bounds.y + node.bounds.h > parent.bounds.y + parent.bounds.h + 0.05 * parent.bounds.h;
  if (overflowLeft || overflowRight || overflowTop || overflowBottom) {
    style.rel = "overflow";
  } else {
    let hasOverlap = false;
    const nodeIndex = siblings.findIndex((s) => s.id === node.id);
    if (nodeIndex > 0) {
      for (let i = 0; i < nodeIndex; i++) {
        const prev = siblings[i];
        const ix1 = Math.max(node.bounds.x, prev.bounds.x);
        const iy1 = Math.max(node.bounds.y, prev.bounds.y);
        const ix2 = Math.min(
          node.bounds.x + node.bounds.w,
          prev.bounds.x + prev.bounds.w
        );
        const iy2 = Math.min(
          node.bounds.y + node.bounds.h,
          prev.bounds.y + prev.bounds.h
        );
        if (ix2 > ix1 && iy2 > iy1) {
          const intersectArea = (ix2 - ix1) * (iy2 - iy1);
          const minArea = Math.min(
            node.bounds.w * node.bounds.h,
            prev.bounds.w * prev.bounds.h
          );
          if (minArea > 0) {
            const ratio = intersectArea / minArea;
            if (ratio >= 0.15 && ratio <= 0.6) {
              hasOverlap = true;
              break;
            }
          }
        }
      }
    }
    if (hasOverlap) {
      style.rel = "overlap";
    } else {
      const leftInset = (node.bounds.x - parent.bounds.x) / parent.bounds.w;
      const rightInset = (parent.bounds.x + parent.bounds.w - (node.bounds.x + node.bounds.w)) / parent.bounds.w;
      if (leftInset >= 0.15 && rightInset >= 0.15 && Math.abs(leftInset - rightInset) <= 0.05) {
        style.rel = "inset";
      }
    }
  }
  return style;
}

// src/core/directive.ts
var AI_DIRECTIVE_HEADER = `> This is a binding layout contract from MarkDraw v4.0. Follow every tag, id, count, placement, width, align, and flag EXACTLY; render positions relative to the parent even if unconventional. \`[Text Placeholder]\` means you MUST generate content (only sanctioned improvisation); everything unspecified (colors, type, imagery) is your freedom \u2014 if the contract is impossible, say so instead of deviating.
> N \xD7 [pattern] and all counts are binding, not suggestions.`;

// src/core/ids.ts
function fnv1a32(str) {
  let hash = 2166136261;
  for (let i = 0; i < str.length; i++) {
    hash ^= str.charCodeAt(i);
    hash += (hash << 1) + (hash << 4) + (hash << 7) + (hash << 8) + (hash << 24);
  }
  return hash >>> 0;
}
function generateShortId(shapeId, existing) {
  const raw = shapeId.startsWith("shape:") ? shapeId.slice(6) : shapeId;
  const hashVal = fnv1a32(raw);
  const baseStr = (hashVal % 46656).toString(36).padStart(3, "0");
  let candidate = baseStr;
  let counter = 2;
  if (existing) {
    while (existing.has(candidate)) {
      candidate = `${baseStr}_${counter}`;
      counter++;
    }
    existing.add(candidate);
  }
  return candidate;
}

// src/annotation/roleDefaults.ts
var ROLE_DEFAULT_PROPS = {
  page: { variant: "hd" },
  section: {},
  card: { variant: "outline" },
  navbar: {},
  sidebar: {},
  footer: {},
  heading: { variant: "h2" },
  para: {},
  img: {},
  video: {},
  button: { variant: "solid" },
  input: { placeholder: "Enter text..." },
  textarea: { placeholder: "Enter multiline text..." },
  select: { options: "Option 1, Option 2, Option 3" },
  checkbox: { checked: false },
  radio: { checked: false },
  switch: { checked: false },
  slider: { value: 50 },
  stepper: { value: 1 },
  table: {},
  tabs: { options: "Tab 1, Tab 2, Tab 3" },
  avatar: {},
  badge: { variant: "outline" },
  banner: { variant: "info" },
  dialog: {},
  separator: { variant: "solid" },
  carousel: { variant: "contained" },
  stat: {},
  steps: { options: "Step 1, Step 2, Step 3" },
  nav: { options: "Link 1, Link 2, Link 3" },
  group: {},
  fab: {},
  bottom_sheet: {},
  scaffold: {}
};
function getRoleDefaultProps(role) {
  return ROLE_DEFAULT_PROPS[role] || {};
}
var COMMON_UNTOUCHED_LABELS = /* @__PURE__ */ new Set([
  "save changes",
  "click me",
  "enter text...",
  "enter multiline text...",
  "lorem ipsum dolor sit amet"
]);
function isUntouchedRoleLabel(role, label) {
  if (!label || label.trim() === "") return true;
  const clean = label.trim().toLowerCase();
  const cleanRole = role.toLowerCase().replace(/_/g, " ");
  if (clean === cleanRole || clean === cleanRole.replace(/\s+/g, "")) {
    return true;
  }
  if (COMMON_UNTOUCHED_LABELS.has(clean)) {
    return true;
  }
  return false;
}

// src/core/notation.ts
function escapeNotation(str) {
  if (!str) return "";
  return str.replace(/\\/g, "\\\\").replace(/\|/g, "\\|").replace(/"/g, '\\"').replace(/\r?\n/g, " ").trim();
}
function getEffectiveLabel(type, label) {
  if (isUntouchedRoleLabel(type, label)) {
    return "";
  }
  return label || "";
}
function getEffectiveProp(type, key, val) {
  if (val === void 0 || val === null || val === "") return "";
  const defaults = getRoleDefaultProps(type);
  if (defaults[key] !== void 0 && defaults[key] === val) {
    return "";
  }
  return val;
}
function formatSemanticNotation(node) {
  if (node.isUnit && node.unitName) {
    return `[${node.unitName}]`;
  }
  if (node.isAnnotationNode) {
    const role = node.role;
    const p2 = node.textProps || {};
    const rawLabel = p2.label || node.label;
    const hasLiteral = !isUntouchedRoleLabel(role, rawLabel);
    const primaryLabel = hasLiteral ? rawLabel : "";
    let tag = "";
    switch (role) {
      case "page": {
        tag = primaryLabel ? `[page "${escapeNotation(primaryLabel)}"]` : "[page]";
        break;
      }
      case "heading": {
        const v = p2.variant;
        const varSuffix = v && v !== "default" ? ` ${v}` : "";
        tag = primaryLabel ? `[heading "${escapeNotation(primaryLabel)}"${varSuffix}]` : varSuffix ? `[heading${varSuffix}]` : "[heading]";
        break;
      }
      case "button": {
        const v = p2.variant;
        const varSuffix = v && v !== "default" && v !== "solid" ? ` ${v}` : "";
        tag = primaryLabel ? `[button "${escapeNotation(primaryLabel)}"${varSuffix}]` : varSuffix ? `[button${varSuffix}]` : "[button]";
        break;
      }
      case "avatar": {
        tag = "[avatar]";
        break;
      }
      case "card": {
        const v = p2.variant;
        const varSuffix = v && v !== "default" && v !== "outline" ? ` ${v}` : "";
        tag = primaryLabel ? `[card "${escapeNotation(primaryLabel)}"${varSuffix}]` : varSuffix ? `[card${varSuffix}]` : "[card]";
        break;
      }
      case "section": {
        const v = p2.variant;
        const varSuffix = v && v !== "default" ? ` ${v}` : "";
        tag = primaryLabel ? `[section "${escapeNotation(primaryLabel)}"${varSuffix}]` : varSuffix ? `[section${varSuffix}]` : "[section]";
        break;
      }
      case "para": {
        tag = "[para]";
        break;
      }
      case "img": {
        tag = "[img]";
        break;
      }
      case "video": {
        tag = "[video]";
        break;
      }
      case "navbar": {
        const v = p2.variant;
        const varSuffix = v && v !== "default" ? ` ${v}` : "";
        tag = primaryLabel ? `[navbar "${escapeNotation(primaryLabel)}"${varSuffix}]` : varSuffix ? `[navbar${varSuffix}]` : "[navbar]";
        break;
      }
      default: {
        const v = p2.variant;
        const varSuffix = v && v !== "default" ? ` ${v}` : "";
        tag = primaryLabel ? `[${role} "${escapeNotation(primaryLabel)}"${varSuffix}]` : varSuffix ? `[${role}${varSuffix}]` : `[${role}]`;
        break;
      }
    }
    if (Array.isArray(p2.behaviors) && p2.behaviors.length > 0) {
      const nonRespFlags = p2.behaviors.filter((f) => f !== "responsive");
      if (nonRespFlags.length > 0 && tag.endsWith("]")) {
        return `${tag.slice(0, -1)} ${nonRespFlags.join(" ")}]`;
      }
    }
    return tag;
  }
  const baseTag = formatBaseNotation(node);
  const p = node.textProps || {};
  if (Array.isArray(p.behaviors) && p.behaviors.length > 0) {
    if (baseTag.endsWith("]")) {
      return `${baseTag.slice(0, -1)} ${p.behaviors.join(" ")}]`;
    }
  }
  return baseTag;
}
function formatBaseNotation(node) {
  const type = node.widgetType;
  const p = node.textProps || {};
  const primaryLabel = getEffectiveLabel(type, p.label || node.label);
  switch (type) {
    case "button": {
      const txt = primaryLabel;
      const v = getEffectiveProp("button", "variant", p.variant);
      const varSuffix = v && v !== "solid" && v !== "default" ? ` ${v}` : "";
      return txt ? `[btn "${escapeNotation(txt)}"${varSuffix}]` : `[btn${varSuffix}]`;
    }
    case "heading": {
      const v = p.variant;
      const varSuffix = v && v !== "default" ? ` ${v}` : "";
      return primaryLabel ? `[header "${escapeNotation(primaryLabel)}"${varSuffix}]` : varSuffix ? `[header${varSuffix}]` : "[header]";
    }
    case "paragraph":
      return "[para]";
    case "input": {
      const placeholder = getEffectiveProp("input", "placeholder", p.placeholder) || primaryLabel;
      return placeholder ? `[input "${escapeNotation(placeholder)}"]` : "[input]";
    }
    case "search": {
      const placeholder = getEffectiveProp("search", "placeholder", p.placeholder) || primaryLabel;
      return placeholder ? `[search "${escapeNotation(placeholder)}"]` : "[search]";
    }
    case "password": {
      const placeholder = p.placeholder;
      return placeholder ? `[password "${escapeNotation(placeholder)}"]` : "[password]";
    }
    case "textarea": {
      const placeholder = p.placeholder || primaryLabel || "";
      return placeholder ? `[textarea "${escapeNotation(placeholder)}"]` : "[textarea]";
    }
    case "date_picker": {
      const placeholder = p.placeholder || primaryLabel;
      return placeholder ? `[date "${escapeNotation(placeholder)}"]` : "[date]";
    }
    case "file_upload": {
      const txt = primaryLabel || "Upload";
      return `[file "${escapeNotation(txt)}"]`;
    }
    case "select": {
      const opts = getEffectiveProp("select", "options", p.options) || getEffectiveProp("select", "placeholder", p.placeholder);
      return opts ? `[select "${escapeNotation(opts)}"]` : "[select]";
    }
    case "slider": {
      const val = typeof p.value === "number" ? p.value : 50;
      return `[slider ${val}]`;
    }
    case "stepper": {
      const val = typeof p.value === "number" ? p.value : 1;
      return `[stepper ${val}]`;
    }
    case "color_swatch": {
      const v = p.variant || primaryLabel;
      return v ? `[color "${escapeNotation(v)}"]` : "[color]";
    }
    case "checkbox": {
      const txt = primaryLabel;
      const flag = p.checked ? "on" : "off";
      return txt ? `[check "${escapeNotation(txt)}" ${flag}]` : `[check ${flag}]`;
    }
    case "radio": {
      const txt = primaryLabel;
      const flag = p.checked ? "on" : "off";
      return txt ? `[radio "${escapeNotation(txt)}" ${flag}]` : `[radio ${flag}]`;
    }
    case "toggle": {
      const flag = p.checked ? "on" : "off";
      return `[toggle ${flag}]`;
    }
    case "navbar":
    case "menubar": {
      const items = getEffectiveProp(type, "options", p.options) || primaryLabel;
      return items ? `[nav "${escapeNotation(items)}"]` : "[navbar]";
    }
    case "sidebar": {
      const items = getEffectiveProp("sidebar", "options", p.options) || primaryLabel;
      return items ? `[sidebar "${escapeNotation(items)}"]` : "[sidebar]";
    }
    case "footer_nav": {
      const items = getEffectiveProp("footer_nav", "options", p.options) || primaryLabel;
      return items ? `[footer_nav "${escapeNotation(items)}"]` : "[footer_nav]";
    }
    case "link": {
      const txt = primaryLabel;
      return txt ? `[link "${escapeNotation(txt)}"]` : "[link]";
    }
    case "chip": {
      const txt = primaryLabel;
      return txt ? `[chip "${escapeNotation(txt)}"]` : "[chip]";
    }
    case "badge": {
      const txt = primaryLabel;
      return txt ? `[badge "${escapeNotation(txt)}"]` : "[badge]";
    }
    case "tabs": {
      const opts = getEffectiveProp("tabs", "options", p.options);
      return opts ? `[tabs "${escapeNotation(opts)}"]` : "[tabs]";
    }
    case "breadcrumbs": {
      const pathStr = getEffectiveProp("breadcrumbs", "options", p.options) || primaryLabel;
      return pathStr ? `[crumb "${escapeNotation(pathStr)}"]` : "[crumb]";
    }
    case "steps": {
      const range = p.variant || "1-4";
      const txt = primaryLabel;
      return txt ? `[steps ${range} "${escapeNotation(txt)}"]` : `[steps ${range}]`;
    }
    case "pagination": {
      const val = p.variant || "1/5";
      return `[pag ${val}]`;
    }
    case "page": {
      const txt = primaryLabel;
      const v = p.variant;
      const varSuffix = v && v !== "default" ? ` ${v}` : "";
      return txt ? `[page "${escapeNotation(txt)}"${varSuffix}]` : varSuffix ? `[page${varSuffix}]` : "[page]";
    }
    case "section": {
      const txt = primaryLabel;
      return txt ? `[section "${escapeNotation(txt)}"]` : "[section]";
    }
    case "header": {
      const txt = primaryLabel;
      return txt ? `[header "${escapeNotation(txt)}"]` : "[header]";
    }
    case "footer": {
      const txt = primaryLabel;
      return txt ? `[footer "${escapeNotation(txt)}"]` : "[footer]";
    }
    case "card": {
      const txt = primaryLabel;
      const v = p.variant;
      const varSuffix = v && v !== "default" && v !== "outline" && v !== "solid" ? ` ${v}` : "";
      return txt ? `[card "${escapeNotation(txt)}"${varSuffix}]` : varSuffix ? `[card${varSuffix}]` : "[card]";
    }
    case "carousel": {
      const txt = primaryLabel;
      const v = p.variant;
      const varSuffix = v && v !== "default" && v !== "contained" ? ` ${v}` : "";
      return txt ? `[carousel "${escapeNotation(txt)}"${varSuffix}]` : varSuffix ? `[carousel${varSuffix}]` : "[carousel]";
    }
    case "hero": {
      const txt = primaryLabel;
      return txt ? `[hero "${escapeNotation(txt)}"]` : "[hero]";
    }
    case "modal": {
      const txt = primaryLabel;
      return txt ? `[modal "${escapeNotation(txt)}"]` : "[modal]";
    }
    case "split_pane":
      return "[split]";
    case "grid_gallery": {
      const v = p.variant || "3x2";
      return `[grid ${v}]`;
    }
    case "list": {
      const count = typeof p.value === "number" && p.value > 0 ? p.value : 5;
      return `[list ${count}]`;
    }
    case "blockquote":
      return "[quote]";
    case "code_block": {
      const code = primaryLabel;
      return code ? `[code "${escapeNotation(code)}"]` : "[code]";
    }
    case "stat_kpi": {
      const kpi = primaryLabel;
      return kpi ? `[kpi "${escapeNotation(kpi)}"]` : "[kpi]";
    }
    case "image_frame": {
      const alt = getEffectiveProp("image_frame", "altText", p.altText) || primaryLabel;
      return alt ? `[img "${escapeNotation(alt)}"]` : "[img]";
    }
    case "video_frame": {
      const src = primaryLabel;
      return src ? `[video "${escapeNotation(src)}"]` : "[video]";
    }
    case "avatar":
      return "[avatar]";
    case "avatar_group":
      return "[avatar_group]";
    case "thumbnail_strip":
      return "[thumbnails]";
    case "icon": {
      const name = getEffectiveProp("icon", "iconName", p.iconName) || primaryLabel;
      return name ? `[icon "${escapeNotation(name)}"]` : "[icon]";
    }
    case "divider":
      return "[divider]";
    case "spacer":
      return "[spacer]";
    case "progress_bar": {
      const val = typeof p.value === "number" ? p.value : 60;
      return `[progress ${val}]`;
    }
    case "skeleton":
      return "[skeleton]";
    case "tooltip": {
      const txt = primaryLabel;
      return txt ? `[tooltip "${escapeNotation(txt)}"]` : "[tooltip]";
    }
    case "toast": {
      const txt = primaryLabel;
      return txt ? `[toast "${escapeNotation(txt)}"]` : "[toast]";
    }
    case "empty_state": {
      const txt = primaryLabel;
      return txt ? `[empty "${escapeNotation(txt)}"]` : "[empty]";
    }
    case "banner": {
      const txt = primaryLabel;
      const v = p.variant || "warn";
      return txt ? `[banner "${escapeNotation(txt)}" ${v}]` : `[banner ${v}]`;
    }
    case "data_table": {
      const v = p.variant || "4x3";
      return `[table ${v}]`;
    }
    default:
      return type ? `[${type}]` : "[unknown]";
  }
}

// src/core/patterns.ts
function getWidgetTagName(widgetType) {
  switch (widgetType) {
    case "button":
      return "btn";
    case "heading":
      return "header";
    case "paragraph":
      return "para";
    case "image_frame":
      return "img";
    case "video_frame":
      return "video";
    case "checkbox":
      return "check";
    case "radio":
      return "radio";
    case "toggle":
      return "toggle";
    case "select":
      return "select";
    case "slider":
      return "slider";
    case "date_picker":
      return "date";
    case "file_upload":
      return "file";
    case "navigation":
    case "navbar":
    case "footer_nav":
      return "nav";
    case "breadcrumbs":
      return "crumb";
    case "pagination":
      return "pag";
    case "steps":
      return "steps";
    case "progress_bar":
      return "progress";
    case "code_block":
      return "code";
    case "stat_kpi":
      return "kpi";
    case "split_pane":
      return "split";
    case "grid_gallery":
      return "grid";
    case "data_table":
    case "table":
      return "table";
    case "icon":
      return "icon";
    case "avatar":
      return "avatar";
    case "divider":
      return "divider";
    case "spacer":
      return "spacer";
    case "toast":
      return "toast";
    case "tooltip":
      return "tooltip";
    case "empty_state":
      return "empty";
    case "banner":
      return "banner";
    default:
      return widgetType.replace(/_/g, "-");
  }
}
function arraysEqual(a, b) {
  if (a.length !== b.length) return false;
  for (let i = 0; i < a.length; i++) {
    if (a[i] !== b[i]) return false;
  }
  return true;
}
function isPrimitivePattern(p) {
  const len = p.length;
  for (let subLen = 1; subLen <= Math.floor(len / 2); subLen++) {
    if (len % subLen === 0) {
      const sub = p.slice(0, subLen);
      let allMatch = true;
      for (let j = subLen; j < len; j += subLen) {
        if (!arraysEqual(sub, p.slice(j, j + subLen))) {
          allMatch = false;
          break;
        }
      }
      if (allMatch) return false;
    }
  }
  return true;
}
function detectSiblingPatterns(children) {
  if (!children || children.length === 0) {
    return "\u2014";
  }
  if (children.length === 1) {
    return formatSemanticNotation(children[0]);
  }
  const types = children.map((c) => c.widgetType || "unknown");
  const n = types.length;
  const segments = [];
  let i = 0;
  while (i < n) {
    let bestL = 0;
    let bestK = 0;
    let bestScore = 0;
    for (let L = 1; L <= 4; L++) {
      if (i + L > n) continue;
      const pattern = types.slice(i, i + L);
      if (!isPrimitivePattern(pattern)) continue;
      let k = 1;
      while (i + (k + 1) * L <= n) {
        const nextSlice = types.slice(i + k * L, i + (k + 1) * L);
        if (arraysEqual(pattern, nextSlice)) {
          k++;
        } else {
          break;
        }
      }
      if (k >= 2) {
        const score = k * L;
        if (score > bestScore) {
          bestScore = score;
          bestL = L;
          bestK = k;
        }
      }
    }
    if (bestK >= 2 && bestL > 0) {
      const patternTypes = types.slice(i, i + bestL);
      const patternTags = patternTypes.map(getWidgetTagName).join(", ");
      segments.push(`${bestK} \xD7 [${patternTags}] (repeated group \u2014 likely card/list items)`);
      for (let pIdx = i; pIdx < i + bestK * bestL; pIdx++) {
        children[pIdx].patternCount = bestK;
      }
      i += bestK * bestL;
    } else {
      segments.push(formatSemanticNotation(children[i]));
      i++;
    }
  }
  return segments.join(", ");
}
function annotateSiblingPatterns(children) {
  detectSiblingPatterns(children);
}

// src/annotation/types.ts
var ROLE_SCHEMA_VERSION = 1;

// src/annotation/shapeMeta.ts
function getShapeMeta(shape) {
  const meta = shape.meta?.markdraw;
  if (!meta || typeof meta !== "object") return null;
  const m = meta;
  if (m.schema !== ROLE_SCHEMA_VERSION) return null;
  return meta;
}

