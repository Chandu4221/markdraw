var ROLE_LIST = Object.freeze(
  ROLE_NAMES.map((name) => ROLE_DEFINITIONS[name])
);
function isValidRole(role) {
  return ROLE_NAMES.includes(role);
}
function isAllowedRoleFlag(role, flag) {
  if (!isValidRole(role)) return false;
  return ROLE_DEFINITIONS[role].flags.includes(flag);
}

// src/core/types.ts
function createShapeId(id) {
  if (id) {
    return id.startsWith("shape:") ? id : `shape:${id}`;
  }
  return `shape:${Math.random().toString(36).slice(2, 9)}`;
}

// src/annotation/migrate.ts
var V3_WIDGET_TO_V4_ROLE_MAP = Object.freeze({
  // Structure
  page: { targetRole: "page" },
  section: { targetRole: "section" },
  card: { targetRole: "card" },
  navbar: { targetRole: "navbar" },
  sidebar: { targetRole: "sidebar" },
  footer: { targetRole: "footer" },
  header: { targetRole: "heading" },
  menubar: { targetRole: "navbar" },
  footer_nav: { targetRole: "nav" },
  nav: { targetRole: "nav" },
  hero: { targetRole: "section", variant: "hero" },
  split_pane: { targetRole: "section", variant: "split" },
  grid_gallery: { targetRole: "section", variant: "grid" },
  modal: { targetRole: "dialog" },
  carousel: { targetRole: "carousel" },
  steps: { targetRole: "steps" },
  tabs: { targetRole: "tabs" },
  // Content
  heading: { targetRole: "heading" },
  para: { targetRole: "para" },
  text: { targetRole: "para" },
  label: { targetRole: "para" },
  image_frame: { targetRole: "img" },
  img: { targetRole: "img" },
  thumbnail_strip: { targetRole: "img", variant: "strip" },
  video_frame: { targetRole: "video" },
  avatar: { targetRole: "avatar" },
  avatar_group: { targetRole: "avatar" },
  icon: { targetRole: "badge", variant: "icon" },
  // Feedback & Utility
  stat_kpi: { targetRole: "stat" },
  kpi: { targetRole: "stat" },
  badge: { targetRole: "badge" },
  banner: { targetRole: "banner" },
  button: { targetRole: "button" },
  input: { targetRole: "input" },
  search: { targetRole: "input", variant: "search" },
  password: { targetRole: "input", variant: "password" },
  textarea: { targetRole: "textarea" },
  select: { targetRole: "select" },
  checkbox: { targetRole: "checkbox" },
  radio: { targetRole: "radio" },
  toggle: { targetRole: "switch" },
  slider: { targetRole: "slider" },
  stepper: { targetRole: "stepper" },
  file_upload: { targetRole: "input", variant: "file" },
  date_picker: { targetRole: "input", variant: "date" },
  color_swatch: { targetRole: "badge", variant: "swatch" },
  table: { targetRole: "table" },
  data_table: { targetRole: "table" },
  divider: { targetRole: "separator" },
  spacer: { targetRole: "group" },
  progress: { targetRole: "stat", variant: "progress" }
});
function isV3Widget(shape) {
  if (shape.type === "ui-widget") return true;
  const props = shape.props;
  if (props && typeof props.widgetType === "string") return true;
  return false;
}
function migrateShapes(shapes) {
  const lints = [];
  const migratedShapes = [];
  const helperBounds = (s) => {
    const p = s.props || {};
    return {
      x: s.x || 0,
      y: s.y || 0,
      w: typeof p.w === "number" && p.w || 100,
      h: typeof p.h === "number" && p.h || 50
    };
  };
  const promotedContainerIds = /* @__PURE__ */ new Set();
  for (const s of shapes) {
    const b = helperBounds(s);
    let count = 0;
    for (const other of shapes) {
      if (other.id === s.id) continue;
      const ob = helperBounds(other);
      if (b.w >= ob.w && b.h >= ob.h) {
        const ix1 = Math.max(b.x, ob.x);
        const iy1 = Math.max(b.y, ob.y);
        const ix2 = Math.min(b.x + b.w, ob.x + ob.w);
        const iy2 = Math.min(b.y + b.h, ob.y + ob.h);
        if (ix2 > ix1 && iy2 > iy1) {
          const intersect = (ix2 - ix1) * (iy2 - iy1);
          if (intersect / (ob.w * ob.h) >= 0.5) {
            count++;
          }
        }
      }
    }
    if (count >= 2) {
      promotedContainerIds.add(s.id);
    }
  }
  for (const shape of shapes) {
    if (!isV3Widget(shape)) {
      migratedShapes.push(shape);
      continue;
    }
    const rawProps = shape.props || {};
    const widgetType = typeof rawProps.widgetType === "string" ? rawProps.widgetType : "card";
    const rule = V3_WIDGET_TO_V4_ROLE_MAP[widgetType] || { targetRole: "card" };
    let targetRole = rule.targetRole;
    if (promotedContainerIds.has(shape.id) && targetRole !== "page" && targetRole !== "section") {
      targetRole = "card";
    }
    const roleDef = ROLE_DEFINITIONS[targetRole];
    const allowedFlags = new Set(roleDef ? roleDef.flags : []);
    const label = typeof rawProps.label === "string" && rawProps.label.trim() || typeof rawProps.text === "string" && rawProps.text.trim() || typeof rawProps.name === "string" && rawProps.name.trim() || void 0;
    const incomingFlags = Array.isArray(rawProps.behaviors) ? rawProps.behaviors : Array.isArray(rawProps.flags) ? rawProps.flags : [];
    const validBehaviors = [];
    for (const flag of incomingFlags) {
      if (allowedFlags.has(flag)) {
        validBehaviors.push(flag);
      } else {
        lints.push(`Flag "${flag}" has no meaning for role "${targetRole}" \u2014 dropped.`);
      }
    }
    const props = {};
    if (label) props.label = label;
    if (typeof rawProps.variant === "string" && rawProps.variant !== "default" && rawProps.variant !== "solid") {
      props.variant = rawProps.variant;
    } else if (rule.variant) {
      props.variant = rule.variant;
    }
    if (typeof rawProps.placeholder === "string") props.placeholder = rawProps.placeholder;
    if (typeof rawProps.options === "string") props.options = rawProps.options;
    if (typeof rawProps.count === "number") props.count = rawProps.count;
    if (typeof rawProps.note === "string") props.note = rawProps.note;
    if (typeof rawProps.value === "number") props.value = rawProps.value;
    if (typeof rawProps.columns === "number") props.columns = rawProps.columns;
    if (typeof rawProps.columnSplit === "string") props.columnSplit = rawProps.columnSplit;
    if (typeof rawProps.isResponsive === "boolean") props.isResponsive = rawProps.isResponsive;
    if (typeof rawProps.mobileStack === "string") props.mobileStack = rawProps.mobileStack;
    if (typeof rawProps.tabletLayout === "string") props.tabletLayout = rawProps.tabletLayout;
    if (typeof rawProps.mobileOrder === "number") props.mobileOrder = rawProps.mobileOrder;
    if (typeof rawProps.hideOnMobile === "boolean") props.hideOnMobile = rawProps.hideOnMobile;
    if (validBehaviors.length > 0) props.behaviors = validBehaviors;
    let parentId = typeof rawProps.parentId === "string" ? rawProps.parentId : shape.parentId && shape.parentId.startsWith("shape:") ? shape.parentId : null;
    if (!parentId && targetRole !== "page") {
      const candidates = shapes.filter((c) => {
        if (c.id === shape.id) return false;
        const cProps = c.props || {};
        const cType = typeof cProps.widgetType === "string" ? cProps.widgetType : "";
        const cRule = V3_WIDGET_TO_V4_ROLE_MAP[cType];
        const cRole = promotedContainerIds.has(c.id) ? "card" : cRule?.targetRole || cProps.role;
        return cRole === "page" || cRole === "section" || cRole === "card" || cRole === "dialog";
      });
      candidates.sort((a, b) => {
        const aProps = a.props || {};
        const bProps = b.props || {};
        const aArea = (aProps.w || 100) * (aProps.h || 100);
        const bArea = (bProps.w || 100) * (bProps.h || 100);
        return aArea - bArea;
      });
      const sBounds = {
        x: shape.x || 0,
        y: shape.y || 0,
        w: typeof rawProps.w === "number" && rawProps.w || 100,
        h: typeof rawProps.h === "number" && rawProps.h || 50
      };
      const sAABB = { minX: sBounds.x, minY: sBounds.y, maxX: sBounds.x + sBounds.w, maxY: sBounds.y + sBounds.h };
      for (const cand of candidates) {
        const cProps = cand.props || {};
        const cBounds = {
          x: cand.x || 0,
          y: cand.y || 0,
          w: typeof cProps.w === "number" && cProps.w || 100,
          h: typeof cProps.h === "number" && cProps.h || 100
        };
        const cAABB = { minX: cBounds.x, minY: cBounds.y, maxX: cBounds.x + cBounds.w, maxY: cBounds.y + cBounds.h };
        if (cBounds.w >= sBounds.w && cBounds.h >= sBounds.h) {
          const ix1 = Math.max(sAABB.minX, cAABB.minX);
          const iy1 = Math.max(sAABB.minY, cAABB.minY);
          const ix2 = Math.min(sAABB.maxX, cAABB.maxX);
          const iy2 = Math.min(sAABB.maxY, cAABB.maxY);
          if (ix2 > ix1 && iy2 > iy1) {
            const intersectArea = (ix2 - ix1) * (iy2 - iy1);
            const childArea = sBounds.w * sBounds.h;
            if (childArea > 0 && intersectArea / childArea >= 0.5) {
              parentId = cand.id;
              break;
            }
          }
        }
      }
    }
    const responsive = rawProps.isResponsive || rawProps.hideOnMobile || typeof rawProps.mobileOrder === "number" ? {
      order: typeof rawProps.mobileOrder === "number" ? rawProps.mobileOrder : "auto",
      primary: false,
      smVisible: rawProps.hideOnMobile ? "hidden" : "visible",
      smFullWidth: false,
      tablet: rawProps.tabletLayout || "maintain"
    } : null;
    const markdrawMeta = {
      schema: ROLE_SCHEMA_VERSION,
      role: targetRole,
      unitId: null,
      parentId,
      responsive,
      props,
      v3WidgetType: widgetType
    };
    const w = typeof rawProps.w === "number" && rawProps.w || 100;
    const h = typeof rawProps.h === "number" && rawProps.h || 50;
    let targetType = shape.type;
    let targetShapeProps = { ...rawProps };
    if (shape.type === "ui-widget") {
      if (targetRole === "page") {
        targetType = "frame";
        targetShapeProps = {
          w,
          h,
          name: label || "Page"
        };
      } else if (targetRole === "group") {
        targetType = "group";
        targetShapeProps = {};
      } else {
        targetType = "geo";
        targetShapeProps = {
          geo: "rectangle",
          w,
          h,
          text: label || ""
        };
      }
    }
    const id = shape.id || createShapeId();
    const migratedShape = {
      ...shape,
      id,
      type: targetType,
      props: targetShapeProps,
      meta: {
        ...shape.meta || {},
        markdraw: markdrawMeta
      }
    };
    migratedShapes.push(migratedShape);
  }
  return {
    shapes: migratedShapes,
    lints,
    docVersion: 4
  };
}

// src/core/ir.ts
function inferDirection(children) {
  if (children.length <= 1) return "Row";
  let minX = Infinity;
  let maxX = -Infinity;
  let minY = Infinity;
  let maxY = -Infinity;
  for (const child of children) {
    const cx = child.bounds.x + child.bounds.w / 2;
    const cy = child.bounds.y + child.bounds.h / 2;
    if (cx < minX) minX = cx;
    if (cx > maxX) maxX = cx;
    if (cy < minY) minY = cy;
    if (cy > maxY) maxY = cy;
  }
  const spanX = maxX - minX;
  const spanY = maxY - minY;
  return spanY > spanX ? "Column" : "Row";
}
function sortChildren(children, direction) {
  if (direction === "Row") {
    children.sort((a, b) => a.bounds.x - b.bounds.x);
  } else {
    children.sort((a, b) => a.bounds.y - b.bounds.y);
  }
}
function buildIRTree(shapes, editor, containmentThreshold = 0.85, options) {
  const hasWidgets = shapes.some((s) => s.type === "ui-widget");
  const migration = hasWidgets ? migrateShapes(shapes) : null;
  const effectiveShapes = migration ? migration.shapes : shapes;
  return buildAnnotationIRTree(effectiveShapes, editor, containmentThreshold, options, migration?.lints);
}
function countSubtree(node) {
  if (!node) return 0;
  let count = 1;
  for (const c of node.children) {
    count += countSubtree(c);
  }
  return count;
}
function buildAnnotationIRTree(shapes, editor, _containmentThreshold = 0.85, options, extraLints = []) {
  if (shapes.length === 0) {
    return { elementCount: 0, roots: [], lints: [] };
  }
  const usedShortIds = /* @__PURE__ */ new Set();
  const rawLints = extraLints.map((text) => ({ text }));
  const relations = [];
  const frames = shapes.filter((s) => s.type === "frame");
  const groups = shapes.filter((s) => s.type === "group");
  const arrows = shapes.filter((s) => s.type === "arrow");
  const otherShapes = shapes.filter(
    (s) => s.type !== "frame" && s.type !== "group" && s.type !== "arrow" && s.type !== "line"
  );
  const getBounds = (shape) => {
    if (editor && typeof editor.getShapePageBounds === "function") {
      const b = editor.getShapePageBounds(shape);
      if (b) return { x: b.x, y: b.y, w: b.w, h: b.h };
    }
    const p = shape.props || {};
    const w = typeof p.w === "number" ? p.w : 100;
    const h = typeof p.h === "number" ? p.h : 100;
    const x = shape.x || 0;
    const y = shape.y || 0;
    return { x, y, w, h };
  };
  const taggedShapes = [];
  const untaggedShapes = [];
  for (const s of otherShapes) {
    const meta = getShapeMeta(s);
    if (meta && meta.role) {
      taggedShapes.push(s);
    } else {
      untaggedShapes.push(s);
    }
  }
  if (untaggedShapes.length > 0) {
    const ids = untaggedShapes.map((s) => `#${generateShortId(s.id, usedShortIds)}`);
    rawLints.push({
      text: `Skipped ${untaggedShapes.length} untagged shapes: ${ids.join(", ")} \u2014 assign roles or delete.`
    });
  }
  const nodeMap = /* @__PURE__ */ new Map();
  const allShapesMap = /* @__PURE__ */ new Map();
  for (const s of shapes) {
    allShapesMap.set(s.id, s);
  }
  const unitDefs = options?.units || [];
  for (const u of unitDefs) {
    if (!u.baseRole) {
      rawLints.push({
        text: `Unit "${u.name}" has no base role \u2014 fix in the customization panel.`
      });
    }
  }
  for (const g of groups) {
    const gMeta = getShapeMeta(g);
    let unitId = gMeta?.unitId || null;
    const memberShapes = shapes.filter((s) => s.parentId === g.id);
    if (!unitId) {
      for (const m of memberShapes) {
        const mMeta = getShapeMeta(m);
        if (mMeta?.unitId) {
          unitId = mMeta.unitId;
          break;
        }
      }
    }
    const unitDef = unitId ? unitDefs.find((u) => u.id === unitId) : null;
    const isUnit = Boolean(unitId || unitDef || gMeta && gMeta.role === "card");
    const baseRole = unitDef?.baseRole || gMeta?.role || (isUnit ? "card" : "group");
    const unitName = unitDef?.name || gMeta?.props?.label || g.props?.name || (isUnit ? "Follow Card" : "group");
    let bounds = getBounds(g);
    if (bounds.w <= 100 && bounds.h <= 100 && memberShapes.length > 0) {
      const childBounds = memberShapes.map(getBounds);
      const minX = Math.min(...childBounds.map((b) => b.x));
      const minY = Math.min(...childBounds.map((b) => b.y));
      const maxX = Math.max(...childBounds.map((b) => b.x + b.w));
      const maxY = Math.max(...childBounds.map((b) => b.y + b.h));
      bounds = { x: minX, y: minY, w: maxX - minX, h: maxY - minY };
    }
    const shortId = generateShortId(g.id, usedShortIds);
    const groupNode = {
      id: g.id,
      shortId,
      parentId: gMeta?.parentId || void 0,
      label: unitName,
      parent: null,
      path: "Root",
      role: baseRole,
      unitId: unitId || (isUnit ? "u_unit" : void 0),
      unitName: isUnit ? unitName : void 0,
      isUnit,
      bounds,
      children: [],
      direction: "Leaf",
      textProps: {
        label: unitName
      },
      widgetType: baseRole,
      isAnnotationNode: true
    };
    nodeMap.set(g.id, groupNode);
  }
  for (const s of taggedShapes) {
    const meta = getShapeMeta(s);
    const role = meta.role;
    const rawLabel = meta.props?.label || s.props?.text || "";
    const label = sanitizeMarkdown(rawLabel);
    const shortId = generateShortId(s.id, usedShortIds);
    const bounds = getBounds(s);
    const behaviors = [];
    if (Array.isArray(meta.props?.behaviors)) {
      for (const flag of meta.props.behaviors) {
        if (isAllowedRoleFlag(role, flag)) {
          behaviors.push(flag);
        } else {
          rawLints.push({
            text: `Flag "${flag}" has no meaning for role "${role}" \u2014 dropped.`,
            shapeId: s.id
          });
        }
      }
    }
    const pMeta = meta.props || {};
    const textProps = {
      label: rawLabel || void 0,
      placeholder: meta.props?.placeholder,
      variant: meta.props?.variant,
      options: meta.props?.options,
      note: meta.props?.note,
      count: meta.props?.count,
      value: typeof pMeta.value === "number" ? pMeta.value : void 0,
      columns: typeof pMeta.columns === "number" ? pMeta.columns : void 0,
      columnSplit: typeof pMeta.columnSplit === "string" ? pMeta.columnSplit : void 0,
      isResponsive: typeof pMeta.isResponsive === "boolean" ? pMeta.isResponsive : void 0,
      mobileStack: typeof pMeta.mobileStack === "string" ? pMeta.mobileStack : void 0,
      tabletLayout: typeof pMeta.tabletLayout === "string" ? pMeta.tabletLayout : void 0,
      mobileOrder: typeof pMeta.mobileOrder === "number" ? pMeta.mobileOrder : void 0,
      hideOnMobile: typeof pMeta.hideOnMobile === "boolean" ? pMeta.hideOnMobile : void 0,
      behaviors: behaviors.length > 0 ? behaviors : void 0
    };
    if (meta.responsive) {
      if (meta.responsive.smVisible === "hidden") textProps.hideOnMobile = true;
      if (typeof meta.responsive.order === "number") textProps.mobileOrder = meta.responsive.order;
      if (meta.responsive.tablet && meta.responsive.tablet !== "maintain") textProps.tabletLayout = meta.responsive.tablet;
    }
    const widgetType = meta.v3WidgetType || s.props?.widgetType || role;
    const node = {
      id: s.id,
      shortId,
      parentId: meta.parentId || void 0,
      label: label || role,
      parent: null,
      path: "Root",
      role,
      bounds,
      children: [],
      direction: "Leaf",
      textProps,
      widgetType,
      isAnnotationNode: true
    };
    nodeMap.set(s.id, node);
  }
  const frameNodes = [];
  for (const f of frames) {
    const meta = getShapeMeta(f);
    const role = meta?.role || "page";
    const rawName = meta?.props?.label || f.props?.name || "Page";
    const label = sanitizeMarkdown(rawName);
    const shortId = generateShortId(f.id, usedShortIds);
    const bounds = getBounds(f);
    const isResp = Boolean(
      meta?.responsive || meta?.props?.behaviors?.includes("responsive") || f.props?.isResponsive
    );
    const behaviors = [];
    if (isResp) behaviors.push("responsive");
    const frameNode = {
      id: f.id,
      shortId,
      label,
      parent: null,
      path: "Root",
      role,
      bounds,
      children: [],
      direction: "Leaf",
      textProps: {
        label: rawName,
        note: meta?.props?.note || f.props?.note,
        isResponsive: isResp,
        behaviors: behaviors.length > 0 ? behaviors : void 0
      },
      widgetType: role,
      isAnnotationNode: true
    };
    nodeMap.set(f.id, frameNode);
    frameNodes.push(frameNode);
  }
  const nonFrameNodes = [...groups, ...taggedShapes].map((s) => nodeMap.get(s.id)).filter((n) => Boolean(n));
  const looseShapes = [];
  for (const node of nonFrameNodes) {
    const s = allShapesMap.get(node.id);
    const meta = getShapeMeta(s);
    let assignedParentId = null;
    if (meta?.parentId) {
      const targetShape = allShapesMap.get(meta.parentId);
      const targetNode = nodeMap.get(meta.parentId);
      if (targetShape && targetNode && targetNode.id !== node.id) {
        const nodeAABB = computeAABB(node.bounds);
        const targetAABB = computeAABB(targetNode.bounds);
        const ratio = getEnclosureRatio(nodeAABB, targetAABB);
        if (ratio >= 0.5) {
          assignedParentId = targetNode.id;
        } else {
          rawLints.push({
            text: `#${node.shortId} has stale parentId "${meta.parentId}" \u2014 clear it or move the shape back inside.`,
            shapeId: node.id
          });
        }
      } else {
        rawLints.push({
          text: `#${node.shortId} has stale parentId "${meta.parentId}" \u2014 clear it or move the shape back inside.`,
          shapeId: node.id
        });
      }
    }
    if (!assignedParentId && s.parentId && nodeMap.has(s.parentId)) {
      const parentShape = allShapesMap.get(s.parentId);
      if (parentShape && parentShape.type === "group") {
        assignedParentId = s.parentId;
      }
    }
    if (!assignedParentId) {
      if (s.parentId && nodeMap.has(s.parentId)) {
        const parentShape = allShapesMap.get(s.parentId);
        if (parentShape && parentShape.type === "frame") {
          assignedParentId = s.parentId;
        }
      }
      if (!assignedParentId && frameNodes.length > 0) {
        for (const fn of frameNodes) {
          const fnAABB = computeAABB(fn.bounds);
          const nAABB = computeAABB(node.bounds);
          if (getEnclosureRatio(nAABB, fnAABB) >= 0.5) {
            assignedParentId = fn.id;
            break;
          }
        }
      }
    }
    if (!assignedParentId && frameNodes.length === 0) {
      const candidates = nonFrameNodes.filter((c) => c.id !== node.id && (c.role === "section" || c.role === "card")).sort((a, b) => a.bounds.w * a.bounds.h - b.bounds.w * b.bounds.h);
      for (const candidate of candidates) {
        const candidateAABB = computeAABB(candidate.bounds);
        const nAABB = computeAABB(node.bounds);
        if (candidate.bounds.w > node.bounds.w && candidate.bounds.h > node.bounds.h && getEnclosureRatio(nAABB, candidateAABB) >= 0.5) {
          assignedParentId = candidate.id;
          break;
        }
      }
    }
    if (assignedParentId) {
      const parentNode = nodeMap.get(assignedParentId);
      if (parentNode) {
        parentNode.children.push(node);
        node.parent = parentNode.id;
      } else {
        looseShapes.push(node);
      }
    } else {
      looseShapes.push(node);
    }
  }
  const activeRoots = [];
  for (const fn of frameNodes) {
    if (fn.children.length === 0) {
      rawLints.push({
        text: `Frame "${fn.label}" has no tagged shapes \u2014 skipped.`,
        shapeId: fn.id
      });
    } else {
      activeRoots.push(fn);
    }
  }
  if (frameNodes.length === 0 && looseShapes.length > 0) {
    activeRoots.push(...looseShapes);
  } else if (looseShapes.length > 0 && !options?.scope) {
    rawLints.push({
      text: `${looseShapes.length} loose shapes outside any frame \u2014 move into a frame or select to compile.`
    });
  }
  const rootPage = activeRoots.find((r) => r.role === "page");
  if (rootPage && !rootPage.textProps?.isResponsive) {
    for (const n of nonFrameNodes) {
      if (n.textProps?.hideOnMobile || typeof n.textProps?.mobileOrder === "number") {
        rawLints.push({
          text: `Responsive props on #${n.shortId} but no responsive root page \u2014 tokens not emitted.`,
          shapeId: n.id
        });
        delete n.textProps.hideOnMobile;
        delete n.textProps.mobileOrder;
      }
    }
  }
  for (const arr of arrows) {
    const props = arr.props || {};
    const startBound = props.start?.boundShapeId;
    const endBound = props.end?.boundShapeId;
    if (startBound && endBound) {
      const startNode = nodeMap.get(startBound);
      const endNode = nodeMap.get(endBound);
      if (startNode && endNode) {
        const text = (props.text || "").trim();
        const rel = text ? ` (${text})` : "";
        relations.push(`Relations: #${startNode.shortId} \u2192 #${endNode.shortId}${rel}`);
      } else {
        rawLints.push({
          text: "Arrow endpoint untagged \u2014 relation omitted.",
          shapeId: arr.id
        });
      }
    }
  }
  let scopedMeta;
  let scopedIds = null;
  if (options?.scope?.shapeIds && options.scope.shapeIds.length > 0) {
    const rawIds = options.scope.shapeIds;
    scopedIds = /* @__PURE__ */ new Set();
    for (const id of rawIds) scopedIds.add(id);
    let added = true;
    while (added) {
      added = false;
      for (const [id, n] of nodeMap.entries()) {
        if (!scopedIds.has(id) && n.parent && scopedIds.has(n.parent)) {
          scopedIds.add(id);
          added = true;
        }
      }
    }
    for (const id of Array.from(scopedIds)) {
      let curr = nodeMap.get(id);
      while (curr && curr.parent) {
        scopedIds.add(curr.parent);
        curr = nodeMap.get(curr.parent);
      }
    }
    const primaryNode = nodeMap.get(rawIds[0]);
    const scopeName = options.scope.scopeName || primaryNode?.unitName || primaryNode?.label || primaryNode?.role || "Selection";
    const rootFrame = activeRoots.find((r) => scopedIds.has(r.id)) || activeRoots[0];
    const totalNodesUnderRoot = countSubtree(rootFrame) - 1;
    const filterSubtree = (node) => {
      node.children = node.children.filter((c) => scopedIds.has(c.id));
      for (const c of node.children) {
        filterSubtree(c);
      }
    };
    for (const r of activeRoots) {
      filterSubtree(r);
    }
    const nodeCountInScope = primaryNode && primaryNode.isUnit ? primaryNode.children.length : countSubtree(primaryNode || rootFrame) - 1;
    const unitCountInScope = Array.from(scopedIds).filter((id) => nodeMap.get(id)?.isUnit).length;
    scopedMeta = {
      scopeName,
      unitCount: Math.max(1, unitCountInScope),
      nodeCount: Math.max(1, nodeCountInScope),
      totalNodes: totalNodesUnderRoot,
      rootName: rootFrame ? rootFrame.label : "Canvas"
    };
  }
  const processSubtree = (node, currentPath, depth) => {
    node.path = currentPath;
    if (node.children.length > 0) {
      node.direction = inferDirection(node.children);
      sortChildren(node.children, node.direction);
      annotateSiblingPatterns(node.children);
      const labelCounts = /* @__PURE__ */ new Map();
      for (const child of node.children) {
        const rawLabel = child.textProps?.label || child.label;
        if (rawLabel && !isUntouchedRoleLabel(child.role, rawLabel)) {
          const entry = labelCounts.get(rawLabel) || { count: 0, ids: [] };
          entry.count++;
          entry.ids.push(child.id);
          labelCounts.set(rawLabel, entry);
        }
      }
      for (const [text, entry] of labelCounts.entries()) {
        if (entry.count >= 2) {
          rawLints.push({
            text: `Identical literal labels "${text}" across ${entry.count} repeated siblings \u2014 consider one template (legend rule: vary per item).`,
            shapeId: node.id
          });
        }
      }
      for (const child of node.children) {
        const nextPath = `${currentPath} > #${child.shortId}`;
        processSubtree(child, nextPath, depth + 1);
      }
    } else {
      node.direction = "Leaf";
    }
  };
  for (const root of activeRoots) {
    const rootPath = `Root > #${root.shortId}`;
    processSubtree(root, rootPath, 0);
  }
  const attachStyles = (curr, parent, siblings) => {
    curr.style = inferNodeStyle(curr, parent, siblings, options);
    for (const child of curr.children) {
      attachStyles(child, curr, curr.children);
    }
  };
  for (const root of activeRoots) {
    attachStyles(root, null, activeRoots);
  }
  let finalLints;
  if (scopedIds && scopedIds.size > 0) {
    finalLints = rawLints.filter((l) => l.shapeId && scopedIds.has(l.shapeId)).map((l) => l.text);
  } else {
    finalLints = rawLints.map((l) => l.text);
  }
  return {
    elementCount: nodeMap.size,
    roots: activeRoots,
    lints: finalLints,
    scopedMeta,
    relations: relations.length > 0 ? relations : void 0
  };
}
function sortKeysAlphabetically(val) {
  if (Array.isArray(val)) {
    return val.map(sortKeysAlphabetically);
  }
  if (val !== null && typeof val === "object") {
    const sortedObj = {};
    const keys = Object.keys(val).sort();
    for (const k of keys) {
      sortedObj[k] = sortKeysAlphabetically(val[k]);
    }
    return sortedObj;
  }
  return val;
}
function pruneDefaultProps(node) {
  const roleOrType = node.role || node.widgetType;
  const defaults = getRoleDefaultProps(roleOrType);
  const cleanProps = {};
  if (node.textProps) {
    for (const [k, v] of Object.entries(node.textProps)) {
      if (v === void 0 || v === null || v === "") continue;
      if (k === "checked" && (v === false || v === defaults.checked)) continue;
      if (k === "showText" && (v === false || v === defaults.showText)) continue;
      if (k === "value" && (v === 0 || v === defaults.value)) continue;
      if (k === "label" && isUntouchedRoleLabel(roleOrType, v)) continue;
      if (Array.isArray(v) && v.length === 0) continue;
      if (defaults[k] !== void 0 && defaults[k] === v) continue;
      cleanProps[k] = v;
    }
  }
  const result = {
    ...node,
    textProps: cleanProps,
    children: node.children.map(pruneDefaultProps)
  };
  if (node.style) {
    const cleanStyle = {};
    if (typeof node.style.widthPct === "number") cleanStyle.widthPct = node.style.widthPct;
    if (node.style.align) cleanStyle.align = node.style.align;
    if (node.style.alignY) cleanStyle.alignY = node.style.alignY;
    if (node.style.dist) {
      cleanStyle.dist = node.style.dist.replace(/^dist:/, "");
    }
    if (node.style.rel) cleanStyle.rel = node.style.rel;
    if (Array.isArray(node.style.behaviors) && node.style.behaviors.length > 0) {
      cleanStyle.behaviors = node.style.behaviors;
    }
    if (node.style.note) cleanStyle.note = node.style.note;
    if (Object.keys(cleanStyle).length > 0) {
      result.style = cleanStyle;
    } else {
      delete result.style;
    }
  }
  return result;
}
function serializeIRToJsonAst(ir) {
  const data = Array.isArray(ir) ? ir : ir.roots;
  const pruned = data.map((rootNode) => {
    const p = pruneDefaultProps(rootNode);
    return {
      aiDirective: AI_DIRECTIVE_HEADER,
      ...p
    };
  });
  const sorted = sortKeysAlphabetically(pruned);
  return JSON.stringify(sorted, null, 2);
}

